# Local API; PostgreSQL is required for full-text retrieval.
ENVIRONMENT=development
APP_NAME=Automotive Assistant
DEBUG=false
API_VERSION=v1
DATABASE_URL=postgresql://automotive:local-development-only@localhost:5432/automotive_db
# Enable only for a local, isolated workshop demo after Alembic upgrade.
WORKSHOP_ENABLED=false
# Required before enabling workshop routes; no default account/password.
WORKSHOP_AUTH_USERNAME=
WORKSHOP_AUTH_PASSWORD_HASH=
WORKSHOP_ORIGIN=http://127.0.0.1:8000
# Optional Gemini drafting of fictional images; private records are blocked.
WORKSHOP_AI_ENABLED=false
WORKSHOP_AI_MODEL=
INTENT_MODEL_PATH=data/models/intent_classifier_v1

# Catalogue fixtures remain synthetic until replaced with authorised real data.
USE_SYNTHETIC_DATA=true
USE_GOOGLE_CSE=false
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_RATE_LIMIT=100
USE_EBAY_API=false
EBAY_APP_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=PRODUCTION
EBAY_MARKETPLACE=EBAY_US
EBAY_RATE_LIMIT=5000
SEARCH_CACHE_TTL=3600
LOG_LEVEL=INFO
LOG_FORMAT=json
